#!/bin/bash
set -euo pipefail
# shellcheck source=vm/common.sh
source "$(dirname "$0")/common.sh"
[[ -f "$VM_SSH_KEY" ]] || { echo "SSH key not found: $VM_SSH_KEY" >&2; exit 1; }
vm_ip="$($TART_BIN ip "$TENBUCKS_VM")"
[[ "$vm_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "No VM IPv4 address; start $TENBUCKS_VM first." >&2; exit 1; }
exec /usr/bin/ssh -F /dev/null -i "$VM_SSH_KEY" \
  -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=8 \
  -o ServerAliveInterval=5 -o ServerAliveCountMax=2 \
  -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$VM_KNOWN_HOSTS" \
  "admin@$vm_ip" "$@"
